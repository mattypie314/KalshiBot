KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_DEMO_URL=https://demo-api.kalshi.co/trade-api/v2
# true = demo-api.kalshi.co (paper). false = live kalshi.com (real money).
# A live API key 401s on demo. Use USE_DEMO=false or ./kb env --prod.
USE_DEMO=true
# Kill switch. true = no live orders, even with --confirm LIVE or the Pi timer.
# Set false only when you mean to resume.
HALTED=true
# Optional. Live is usually ./kb live then type LIVE (or --confirm LIVE).
# Unattended live (systemd, no TTY) requires BOTH of these plus HALTED=false.
# --confirm LIVE alone is not enough without a keyboard.
LIVE_TRADING=false
CONFIRM_LIVE=NO
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PRIVATE_KEY=
BANKROLL=40
MIN_NET_EDGE=0.06
SOFT_NET_EDGE=0.06
MAX_RISK_PCT=0.05
MAX_RISK_DOLLARS=2.00
PREFERRED_RISK_DOLLARS=1.75
KELLY_MULT=0.25
MIN_STRIKE_DISTANCE_PCT=0.005
MIN_STRIKE_SIGMA=1.5
CLOSE_STRIKE_EDGE=0.10
VOL_PAUSE_MULT=2.0
ASSETS=BTC,ETH
MAX_MARKETS_PER_ASSET=12
MAX_IDEAS_PER_RUN=1
MIN_MINUTES_LEFT=3
MAX_SPREAD=0.06
MIN_VISIBLE_DEPTH_CONTRACTS=5
MAX_DAILY_LOSS_DOLLARS=4.00
MAX_DAILY_LOSSES=2
# Price: CF Benchmarks BRTI/ERTI via Kalshi first. Coinbase/Binance are display
# proxies only — they are not settlement truth. Ideas sit without BRTI/ERTI.
SPOT_SOURCE=cfbenchmarks
REQUIRE_SETTLEMENT_INDEX=true
REQUIRE_MAKER=true
# Operator sit for war tape / headlines. Does not scrape news. 2× vol also sits.
NEWS_PAUSE=false
HOURLY_VOL_FALLBACK_BTC=0.004
HOURLY_VOL_FALLBACK_ETH=0.005
