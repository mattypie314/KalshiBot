KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_DEMO_URL=https://demo-api.kalshi.co/trade-api/v2
# true = demo-api.kalshi.co (paper). false = live kalshi.com (real money).
# A live API key 401s on demo. Use USE_DEMO=false or ./kb env --prod.
USE_DEMO=true
# Kill switch. true = no live orders, even with --confirm LIVE or the Pi timer.
# Set false only when you mean to resume.
HALTED=true
# Optional. Live is usually ./kb live then type LIVE (or --confirm LIVE).
# Unattended live (systemd, no TTY) requires BOTH of these plus HALTED=false.
# --confirm LIVE alone is not enough without a keyboard.
LIVE_TRADING=false
CONFIRM_LIVE=NO
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PRIVATE_KEY=
BANKROLL=40
MIN_NET_EDGE=0.06
SOFT_NET_EDGE=0.06
MAX_RISK_PCT=0.05
MAX_RISK_DOLLARS=2.00
PREFERRED_RISK_DOLLARS=1.75
KELLY_MULT=0.25
MIN_STRIKE_DISTANCE_PCT=0.005
MIN_STRIKE_SIGMA=1.5
CLOSE_STRIKE_EDGE=0.10
# Turbo Mode. false = current strict Pass (default). true = soften close-strike /
# min-edge enough to rest a maker on the nearest viable strike. Still maker-only,
# still BRTI (BTC) / ERTI (ETH), still MAX_RISK, one idea per run.
# Tickets are labeled forced / Turbo / FORCE_NEAR_RULE in journal, last_run, trade_log.
FORCE_NEAR_RULE=false
VOL_PAUSE_MULT=2.0
ASSETS=BTC,ETH
MAX_MARKETS_PER_ASSET=12
MAX_IDEAS_PER_RUN=1
MIN_MINUTES_LEFT=3
MAX_SPREAD=0.06
MIN_VISIBLE_DEPTH_CONTRACTS=5
MAX_DAILY_LOSS_DOLLARS=4.00
MAX_DAILY_LOSSES=2
# Price: CF Benchmarks BRTI/ERTI via Kalshi first. Coinbase/Binance are display
# proxies only — they are not settlement truth. Ideas sit without BRTI/ERTI.
SPOT_SOURCE=cfbenchmarks
REQUIRE_SETTLEMENT_INDEX=true
REQUIRE_MAKER=true
# Operator sit for war tape / headlines. Does not scrape news. 2× vol also sits.
NEWS_PAUSE=false
HOURLY_VOL_FALLBACK_BTC=0.004
HOURLY_VOL_FALLBACK_ETH=0.005
# Paper tape for dry scans. Do not mix with live fills.
# assumed-maker-fill = score at the printed maker limit ("if we got that quote").
# unfilled = leave those tickets unscored (stricter).
PAPER_LOG_PATH=artifacts/paper_log.jsonl
PAPER_FILL_MODEL=assumed-maker-fill

# --- 15m bot (use a separate checkout / .env at /home/KalshiBot15) ---
# Copy .env.fifteen.example there. Do not mix these knobs into hourly .env
# or the two HALTED / LIVE_TRADING gates will fight.
# ETH settlement id for 15m is ETHUSD_RTI (never ERTI).
