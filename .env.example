# Shared Kalshi setup (never commit .env or any .pem)
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_DEMO_URL=https://demo-api.kalshi.co/trade-api/v2
USE_DEMO=true
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/kalshi_private_key.pem
KALSHI_PRIVATE_KEY=

# Dashboard / campaign live switch (Pi DRY/LIVE pill). Default off.
KALSHI_LIVE=false
KALSHI_AUTO=true
TRACKER_PATH=~/.kalshi/crypto-campaign.json

# Hourly KXBTCD / KXETHD scanner. Live needs BOTH flags.
LIVE_TRADING=false
CONFIRM_LIVE=NO
BANKROLL=46.36
MIN_NET_EDGE=0.06
SOFT_NET_EDGE=0.04
MAX_RISK_PCT=0.05
MAX_RISK_DOLLARS=3.00
PREFERRED_RISK_DOLLARS=2.00
KELLY_MULT=0.25
ASSETS=BTC,ETH
MAX_MARKETS_PER_ASSET=12
MAX_IDEAS_PER_RUN=1
MIN_MINUTES_LEFT=3
MAX_SPREAD=0.06
MIN_VISIBLE_DEPTH_CONTRACTS=5
SPOT_SOURCE=binance
HOURLY_VOL_FALLBACK_BTC=0.004
HOURLY_VOL_FALLBACK_ETH=0.005

# Research desk
SERIES_PER_SECTION=12
MAX_EVENTS_PER_SERIES=3
CACHE_TTL_SECONDS=60
MAX_CONCURRENCY=3
MIN_EDGE=0.02
KALSHI_MIN_INTERVAL=0.3
