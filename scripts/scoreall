#!/bin/sh
# Combined paper board: 15m + hourly pots/plays, tagged, never live cash.
#   scoreall | python -m src.scoreboard scoreall
set -e
if command -v readlink >/dev/null 2>&1; then
  here=$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")
else
  here="$0"
fi
scripts_dir=$(CDPATH= cd -- "$(dirname "$here")" && pwd)
exec "$scripts_dir/kb-scoreboard" scoreall "$@"
