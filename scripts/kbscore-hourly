#!/bin/sh
# Hourly paper Termius board (assumed fills, not live cash).
#   kbscore-hourly | score-hourly | ./kb score | python -m src.scoreboard score-hourly
set -e
if command -v readlink >/dev/null 2>&1; then
  here=$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")
else
  here="$0"
fi
scripts_dir=$(CDPATH= cd -- "$(dirname "$here")" && pwd)
exec "$scripts_dir/kb-scoreboard" score-hourly "$@"
