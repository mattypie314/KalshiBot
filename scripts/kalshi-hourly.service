[Unit]
Description=KalshiBot hourly BTC/ETH scan (dry-run, not live)
After=network-online.target

[Service]
Type=oneshot
User=mkubit
WorkingDirectory=/home/KalshiBot
Environment=PYTHONPATH=/home/KalshiBot
EnvironmentFile=-/home/KalshiBot/.env
EnvironmentFile=-/home/mkubit/.kalshi/env
# venv python. `once` is dry-run only. Live stays ./kb live --prod
ExecStart=/home/KalshiBot/.venv/bin/python -m src.main once

[Install]
WantedBy=multi-user.target
