[Unit]
Description=Run KalshiBot15 at :02–:05 of each 15m block Eastern
# Ship DISABLED — do not enable until armed. Hourly kalshi-hourly.timer is a
# different unit under /home/KalshiBot — leave it alone.

[Timer]
# Fire across minutes 2–5 of each 15m block. The live Pi unit was :02, and a
# single :03 oneshot plus 1min AccuracySec sat every window.
# :01/:16/:31/:46 is still early — Python waits until minute 2.
OnCalendar=*-*-* *:02,03,04,05,17,18,19,20,32,33,34,35,47,48,49,50:00 America/New_York
# Default AccuracySec is 1min and can slip the oneshot past minute 5.
AccuracySec=1s
RandomizedDelaySec=0
# Do not catch up after downtime — a late fire would use a stale window.
Persistent=false

[Install]
WantedBy=timers.target
