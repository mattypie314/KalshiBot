#!/bin/sh
# Termius live (real money) scoreboard for 15m.
# Uses fifteen_trade_log.jsonl + scan sits; skips kind=backfill recon rows.
#   kbscore-live | livescore | ./kb15 livescore | python -m src.fifteen livescore
set -e
export FORCE_COLOR="${FORCE_COLOR:-1}"
if command -v readlink >/dev/null 2>&1; then
  here=$(readlink -f "$0" 2>/dev/null || printf '%s\n' "$0")
else
  here="$0"
fi
scripts_dir=$(CDPATH= cd -- "$(dirname "$here")" && pwd)
root=$(CDPATH= cd -- "$scripts_dir/.." && pwd)
if [ ! -f "$root/kb15" ]; then
  root="${KALSHIBOT15_ROOT:-/home/KalshiBot15}"
fi
export PYTHONPATH="${PYTHONPATH:-$root}"
cd "$root" || exit 1
if [ -x "$root/.venv/bin/python" ]; then
  py="$root/.venv/bin/python"
else
  py="python3"
fi
exec "$py" -m src.fifteen livescore "$@"
