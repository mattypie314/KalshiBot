# Copy to /home/KalshiBot15/.env — separate from hourly /home/KalshiBot/.env
# so HALTED / LIVE_TRADING / CONFIRM_LIVE do not fight across bots.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_DEMO_URL=https://demo-api.kalshi.co/trade-api/v2
USE_DEMO=true
# Kill switch. true = no live 15m orders, even with --confirm LIVE.
HALTED=true
LIVE_TRADING=false
CONFIRM_LIVE=NO
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Shared read of ~/.kalshi PEMs is OK. Never commit PEMs.

# Own $5 pot (not hourly BANKROLL / hourly_pot).
FIFTEEN_POT_START=5
FIFTEEN_POT_ASK=10
MIN_RISK_DOLLARS=0.10
MAX_RISK_DOLLARS=1.50
PREFERRED_RISK_DOLLARS=0.85
MAX_RISK_PCT=0.05
KELLY_MULT=0.25

ASSETS=BTC,ETH
SERIES=KXBTC15M,KXETH15M
EXCHANGE_INDEX=2
MAX_IDEAS_PER_WINDOW=1
REQUIRE_SETTLEMENT_INDEX=true
REQUIRE_MAKER=true
NEWS_PAUSE=false
MID_TOLERANCE=0.04
MIN_MINUTES_LEFT=8
MAX_DAILY_LOSSES=3
LAST_MINUTE_MAKER=true
STACK_LAST_MINUTE_WITH_EDGE=false

# TEMPORARY HEURISTIC: shorter realized-vol lookback than hourly's ~4h.
FIFTEEN_VOL_LOOKBACK_MINUTES=90
FIFTEEN_VOL_FALLBACK_BTC=0.004
FIFTEEN_VOL_FALLBACK_ETH=0.005

SPOT_SOURCE=cfbenchmarks
# Settlement: BTC=BRTI  ETH=ETHUSD_RTI (never ERTI). Coinbase is display only.

POT_PATH=artifacts/fifteen_pot.json
STATE_PATH=artifacts/fifteen_state.json
LAST_RUN_PATH=artifacts/last_run.json
SCAN_LOG_PATH=artifacts/fifteen_scan_log.jsonl
PAPER_LOG_PATH=artifacts/fifteen_paper_log.jsonl
TRADE_LOG_PATH=artifacts/fifteen_trade_log.jsonl
PAPER_FILL_MODEL=assumed-maker-fill
# Hard flatten when the held-side live bid hits this (99¢). Beats +2¢ TP.
# Live oneshots place the exit (label cash_out_99) — not operator-notify-only.
CASH_OUT_BID=0.99
TAKE_PROFIT_CENTS=0.02

# Paper/scan only: after Pass, sit when the tape is chop (low ADX + tight Bollinger).
# Does not change live order placement, Turbo, or 99¢ cash-out. Set false to disable.
FIFTEEN_CHOP_VETO=true
