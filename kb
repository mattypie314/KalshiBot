#!/bin/sh
# Short switcher: ./kb          → menu
#                 ./kb scan     (s / 1)
#                 ./kb once     (o / 2)
#                 ./kb auth     (a / 3)
#                 ./kb live     (l / 4)
#                 ./kb env      (e / 5)   show/set USE_DEMO in .env
root="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
export PYTHONPATH="${PYTHONPATH:-$root}"
cd "$root" || exit 1
if [ -x "$root/.venv/bin/python" ]; then
  py="$root/.venv/bin/python"
else
  py="python3"
fi
exec "$py" -m src.main "$@"
